# AI Provider API Keys (Set whichever one you prefer to use)
# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Select active provider: 'anthropic' | 'openai' | 'gemini' | 'auto' (default auto selects based on key present)
AI_PROVIDER=auto
